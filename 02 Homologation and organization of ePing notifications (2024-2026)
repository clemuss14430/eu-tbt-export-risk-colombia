import pandas as pd
import numpy as np
import re

# ─────────────────────────────────────────────────────────────────────────────
# 1. LOAD DATA AND APPLY INITIAL FILTER
# ─────────────────────────────────────────────────────────────────────────────

raw_data = pd.read_excel("Notifications (Jan 2024 - Today).xlsx")

df = raw_data[
    (raw_data["Notifying Member"] == "European Union") &
    (raw_data["Objectives"].str.contains("environment", case=False, na=False))
].copy()

print(f"Raw EU environmental notifications: {len(df)}")


# ─────────────────────────────────────────────────────────────────────────────
# 2. FUNCTION TO EXTRACT CODES
# ─────────────────────────────────────────────────────────────────────────────

def extract_code_list(text):
    """
    Extract numeric HS or ICS codes from a text field.
    Returns a list of unique codes.
    """

    if pd.isna(text) or str(text).strip().lower() in (
        "nan", "none", "", "."
    ):
        return []

    elements = str(text).split(";")
    codes = []

    for item in elements:
        item = item.strip()
        match = re.search(r"(\d[\d\.]+)", item)

        if match:
            code = match.group(1).strip(".")

            if code:
                codes.append(code)

    return list(set(codes))


df["HS_Clean_List"] = df["HS code(s)"].apply(extract_code_list)
df["ICS_Clean_List"] = df["ICS code(s)"].apply(extract_code_list)


# ─────────────────────────────────────────────────────────────────────────────
# 3. EXACT MAPPING DICTIONARY
#    ONLY THE MAPPINGS DEFINED IN EXCEL V4
# ─────────────────────────────────────────────────────────────────────────────

ics_to_hs = {

    "07.080": "90",

    "11.120": "30",
    "11.220": "30",

    "13.020": "ENV-General",
    "13.030.30": "ENV-General",
    "13.040.50": "ENV-General",
    "13.220.10": "ENV-General",
    "13.220.20": "ENV-General",

    "29.060.01": "85",
    "29.220": "85",
    "29.220.99": "85",

    "31.020": "85",
    "33.060": "85",

    "35.260": "84",

    "43.080": "87",

    "47.020.70": "90",

    "65.020.20": "01-24",
    "65.020.30": "01-24",
    "65.080": "01-24",
    "65.100": "01-24",
    "65.120": "01-24",

    "67": "16-24",

    "71.100": "28-38",
    "71.100.70": "28-38",
    "71.120": "28-38",

    "83.080": "39-40",

    "91": "68-70",

    "97": "94-96",
    "97.220": "94-96",
}


# ─────────────────────────────────────────────────────────────────────────────
# 4. CODE RESOLUTION FUNCTION
#    NO ADDITIONAL INFERENCES
# ─────────────────────────────────────────────────────────────────────────────

def resolve_ics(ics_code):
    """
    Resolve an ICS code using the predefined mapping dictionary.
    Unmapped codes are preserved as ICS_xxx.
    """

    clean_ics = str(ics_code).strip()

    if clean_ics in ics_to_hs:
        return ics_to_hs[clean_ics]

    return f"ICS_{clean_ics}"


# ─────────────────────────────────────────────────────────────────────────────
# 5. CREATE CROSS-MATCHING KEY FROM HS CODE
# ─────────────────────────────────────────────────────────────────────────────

def create_hs_key(hs_code):
    """
    Create the matching key used to link HS codes with the export dataset.
    """

    clean_code = str(hs_code).replace(".", "").strip()

    if len(clean_code) <= 2:
        return clean_code
    else:
        return clean_code[:4] if len(clean_code) >= 4 else clean_code[:2]


# ─────────────────────────────────────────────────────────────────────────────
# 6. EXPLODE ROWS
# ─────────────────────────────────────────────────────────────────────────────

rows = []

for _, row in df.iterrows():

    hs_list = row["HS_Clean_List"]
    ics_list = row["ICS_Clean_List"]

    if not hs_list and not ics_list:
        continue

    # Priority 1: HS codes
    if hs_list:

        for hs in hs_list:

            new_row = row.copy()

            new_row["HS_Separated"] = hs
            new_row["ICS_Separated"] = ""
            new_row["Cross_Match_Key"] = create_hs_key(hs)

            rows.append(new_row)

    # Priority 2: ICS codes
    else:

        for ics in ics_list:

            new_row = row.copy()

            new_row["HS_Separated"] = ""
            new_row["ICS_Separated"] = ics.strip()
            new_row["Cross_Match_Key"] = resolve_ics(ics)

            rows.append(new_row)


# ─────────────────────────────────────────────────────────────────────────────
# 7. CREATE FINAL DATAFRAME
# ─────────────────────────────────────────────────────────────────────────────

final_data = pd.DataFrame(rows)

columns_to_keep = [
    "Distribution date",
    "Document symbol",
    "Title",
    "Description",
    "Products covered",
    "HS code(s)",
    "HS_Separated",
    "ICS code(s)",
    "ICS_Separated",
    "Objectives",
    "Proposed date of adoption",
    "Proposed date of entry into force",
    "Link to notification(EN)",
    "Cross_Match_Key"
]

final_data = final_data[
    [column for column in columns_to_keep if column in final_data.columns]
]

final_data["HS_Separated"] = final_data["HS_Separated"].fillna("")
final_data["ICS_Separated"] = final_data["ICS_Separated"].fillna("")


# ─────────────────────────────────────────────────────────────────────────────
# 8. EXPORT CLEAN DATASET
# ─────────────────────────────────────────────────────────────────────────────

output_file = "Clean_ePing_Alerts_V5.xlsx"

final_data.to_excel(
    output_file,
    index=False
)


