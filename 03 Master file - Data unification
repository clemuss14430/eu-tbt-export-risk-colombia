import pandas as pd
import numpy as np

# ============================================================
# LOAD DATASETS
# ============================================================

df_exports = (
    pd.read_excel("Master_Exports_UE_2019-2025.xlsx")
    .dropna(subset=["Periodo"])
)

df_tbt = pd.read_excel(
    "TBTs_Amb_Limpio_2019-2023.xlsx",
    sheet_name="HS limpio MANUFACTURAS"
)

df_eping = pd.read_excel(
    "Alertas_ePing_Limpias_V4.xlsx"
)

# Standardize data types
df_exports["Periodo"] = df_exports["Periodo"].astype(int)
df_exports["HS_Key"] = df_exports["HS_Key"].astype(int)
df_exports["Codigo capitulo"] = df_exports["Codigo capitulo"].astype(int)

df_tbt["HS_Key"] = df_tbt["HS_Key"].astype(int)
df_tbt["HS_Cod 2"] = df_tbt["HS_Cod 2"].astype(int)


# ============================================================
# BRIDGE TABLE: ePing CROSS-MATCH KEY → ACTUAL HS CHAPTERS
#
# Expands ranges (e.g., "39-40") and maps exact HS headings
# to their corresponding chapter.
#
# Only chapters present in the export dataset are retained.
# ============================================================

chapters_in_exports = set(
    df_exports["Codigo capitulo"].unique()
)


def map_key_to_chapters(cross_match_key):
    """
    Convert a Cross_Match_Key into a list of actual HS chapters.
    """

    key = str(cross_match_key).strip()

    # Range such as "39-40" or "94-96"
    if "-" in key and not key.startswith("ENV"):

        parts = key.split("-")

        try:
            start, end = int(parts[0]), int(parts[1])

            return [
                chapter
                for chapter in range(start, end + 1)
                if chapter in chapters_in_exports
            ]

        except:
            return []

    # Exact 4-digit HS heading (e.g., "8517", "8704", "9507")
    if key.isdigit() and len(key) == 4:

        chapter = int(key[:2])

        return [
            chapter
        ] if chapter in chapters_in_exports else []

    # 2-digit HS chapter (e.g., "85", "87", "90")
    if key.isdigit() and len(key) == 2:

        chapter = int(key)

        return [
            chapter
        ] if chapter in chapters_in_exports else []

    # ENV-General and other non-numeric keys:
    # no direct mapping
    return []


# Build bridge table
bridge_rows = []

for _, row in df_eping.iterrows():

    chapters = map_key_to_chapters(
        row["Llave_Cruce"]
    )

    for chapter in chapters:

        bridge_rows.append({
            "Document_symbol": row["Document symbol"],
            "Cross_Match_Key": row["Llave_Cruce"],
            "HS_Chapter": chapter,
            "Distribution_date": row["Distribution date"],
            "ePing_Title": row["Title"],
            "ePing_Link": row["Link to notification(EN)"]
        })


df_bridge = (
    pd.DataFrame(bridge_rows)
    .drop_duplicates()
)

print(
    f"Bridge table: {len(df_bridge)} rows"
)

print(
    "ePing chapters mapped to export data: "
    f"{sorted(df_bridge['HS_Chapter'].unique())}"
)


# ============================================================
# LEVEL 1: ANNUAL EXPORTS BY HS HEADING
# ============================================================

export_pivot = df_exports.pivot_table(
    index=[
        "HS_Key",
        "Nombre partida",
        "Codigo capitulo",
        "Nombre capitulo"
    ],
    columns="Periodo",
    values=" Dolares FOB",
    aggfunc="sum"
).reset_index()


# Rename year columns
export_pivot.columns = [
    str(column) if isinstance(column, int) else column
    for column in export_pivot.columns
]


# Calculate export trend metrics
years = [
    str(year)
    for year in range(2019, 2026)
    if str(year) in export_pivot.columns
]

export_pivot["Total_2019_2025"] = (
    export_pivot[years].sum(axis=1)
)

export_pivot["Change_2019_2023"] = (
    export_pivot.get("2023", 0)
    - export_pivot.get("2019", 0)
)

export_pivot["Change_2024_2025"] = (
    export_pivot.get("2025", 0)
    - export_pivot.get("2024", 0)
)


export_pivot["Post_TBT_Trend"] = (
    export_pivot["Change_2024_2025"]
    .apply(
        lambda x:
        "Growing"
        if x > 0
        else (
            "Declining"
            if x < 0
            else "Stable"
        )
    )
)


# ============================================================
# LEVEL 2: I-TIP TBT COUNT BY HS HEADING
# ============================================================

tbt_by_heading = (
    df_tbt
    .groupby("HS_Key")
    .agg(
        TBT_Count=("HS_Key", "count"),
        TBT_Min_Date=("En preparación", "min"),
        TBT_Max_Date=("En preparación", "max"),
        TBT_Keywords=(
            "Palabras clave",
            lambda x:
            " | ".join(
                x.dropna().unique()[:3]
            )
        )
    )
    .reset_index()
)


# ============================================================
# LEVEL 3: ePing ALERT COUNT BY HS CHAPTER
# ============================================================

eping_by_chapter = (
    df_bridge
    .groupby("HS_Chapter")
    .agg(
        ePing_Alerts=(
            "Document_symbol",
            "nunique"
        ),
        ePing_Min_Date=(
            "Distribution_date",
            "min"
        ),
        ePing_Max_Date=(
            "Distribution_date",
            "max"
        ),
        ePing_Cross_Match_Keys=(
            "Cross_Match_Key",
            lambda x:
            " | ".join(x.unique())
        )
    )
    .reset_index()
)


# ============================================================
# BUILD MASTER RISK DATASET
# ============================================================

master_data = export_pivot.copy()


# Merge with TBT data by HS heading
master_data = master_data.merge(
    tbt_by_heading,
    on="HS_Key",
    how="left"
)


# Merge with ePing data by HS chapter
master_data = master_data.merge(
    eping_by_chapter,
    left_on="Codigo capitulo",
    right_on="HS_Chapter",
    how="left"
).drop(
    columns=["HS_Chapter"],
    errors="ignore"
)


# Fill missing risk indicators
master_data["TBT_Count"] = (
    master_data["TBT_Count"]
    .fillna(0)
    .astype(int)
)

master_data["ePing_Alerts"] = (
    master_data["ePing_Alerts"]
    .fillna(0)
    .astype(int)
)


# ============================================================
# RISK PERSISTENCE INDEX
# ============================================================

def classify_risk(row):
    """
    Classify regulatory risk based on historical I-TIP
    measures and new ePing alerts.
    """

    has_tbt = row["TBT_Count"] > 0
    has_eping = row["ePing_Alerts"] > 0

    if has_tbt and has_eping:
        return "🔴 Extreme Risk"

    elif has_eping and not has_tbt:
        return "🟡 Emerging Risk"

    elif has_tbt and not has_eping:
        return "🟠 Chronic Risk"

    else:
        return "🟢 No Identified Risk"


master_data["Risk_Persistence_Index"] = (
    master_data
    .apply(classify_risk, axis=1)
)


# Numerical score for Power BI ranking
risk_score_map = {
    "🔴 Extreme Risk": 4,
    "🟡 Emerging Risk": 3,
    "🟠 Chronic Risk": 2,
    "🟢 No Identified Risk": 1
}

master_data["Risk_Score"] = (
    master_data["Risk_Persistence_Index"]
    .map(risk_score_map)
)


# ============================================================
# NARRATIVE RISK CONTEXT
# Used for Power BI tooltips
# ============================================================

def generate_risk_narrative(row):

    if row["Risk_Score"] == 4:

        return (
            f"HS heading with {row['TBT_Count']} "
            f"I-TIP TBT measures under preparation and "
            f"{row['ePing_Alerts']} active ePing alerts "
            f"(2024-2026). "
            f"2025 exports show a "
            f"{row['Post_TBT_Trend'].lower()} trend."
        )

    elif row["Risk_Score"] == 3:

        return (
            f"No historical TBT record in I-TIP, but "
            f"{row['ePing_Alerts']} new ePing alerts "
            f"in 2024-2026 represent emerging risk."
        )

    elif row["Risk_Score"] == 2:

        return (
            f"{row['TBT_Count']} TBT measures under "
            f"preparation in I-TIP. "
            f"No new ePing alerts. "
            f"Exports show a "
            f"{row['Post_TBT_Trend'].lower()} trend "
            f"in 2024-2025."
        )

    else:

        return (
            "No TBT measures or ePing alerts "
            "identified during the analyzed period."
        )


master_data["Risk_Narrative"] = (
    master_data
    .apply(generate_risk_narrative, axis=1)
)


# ============================================================
# SORT AND SELECT FINAL COLUMNS
# ============================================================

final_columns = (
    [
        "HS_Key",
        "Nombre partida",
        "Codigo capitulo",
        "Nombre capitulo"
    ]
    + years
    + [
        "Total_2019_2025",
        "Change_2019_2023",
        "Change_2024_2025",
        "Post_TBT_Trend"
    ]
    + [
        "TBT_Count",
        "TBT_Min_Date",
        "TBT_Max_Date",
        "TBT_Keywords"
    ]
    + [
        "ePing_Alerts",
        "ePing_Min_Date",
        "ePing_Max_Date",
        "ePing_Cross_Match_Keys"
    ]
    + [
        "Risk_Persistence_Index",
        "Risk_Score",
        "Risk_Narrative"
    ]
)


master_data = (
    master_data[final_columns]
    .sort_values(
        ["Risk_Score", "Total_2019_2025"],
        ascending=[False, False]
    )
)


# ============================================================
# FINAL BRIDGE TABLE
# Separate worksheet in the Excel output
# ============================================================

final_bridge = df_bridge[
    [
        "Cross_Match_Key",
        "HS_Chapter",
        "Document_symbol",
        "Distribution_date",
        "ePing_Title",
        "ePing_Link"
    ]
]


# ============================================================
# EXPORT EXCEL WORKBOOK WITH TWO WORKSHEETS
# ============================================================

output_file = "TBT_ePing_Risk_Master.xlsx"

with pd.ExcelWriter(
    output_file,
    engine="openpyxl"
) as writer:

    master_data.to_excel(
        writer,
        sheet_name="Master_Risk",
        index=False
    )

    final_bridge.to_excel(
        writer,
        sheet_name="ePing_Bridge_Table",
        index=False
    )


# ============================================================
# EXECUTIVE SUMMARY
# ============================================================

print("\n" + "=" * 60)
print("EXECUTIVE SUMMARY - MASTER RISK DATASET")
print("=" * 60)

print(
    f"Total HS headings analyzed: "
    f"{len(master_data)}"
)

print(
    "\nRisk Persistence Index distribution:"
)

print(
    master_data[
        "Risk_Persistence_Index"
    ]
    .value_counts()
    .to_string()
)


print(
    "\nTop 10 HS headings by risk and export value:"
)

top_columns = [
    "HS_Key",
    "Nombre partida",
    "Total_2019_2025",
    "TBT_Count",
    "ePing_Alerts",
    "Risk_Persistence_Index"
]

print(
    master_data[
        top_columns
    ]
    .head(10)
    .to_string()
)


print(
    f"\nFile exported successfully: {output_file}"
)
