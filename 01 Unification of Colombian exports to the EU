import pandas as pd
import glob

# --------------------------------------------------
# 1. LOAD ALL EXCEL FILES FROM THE FOLDER
# --------------------------------------------------

files = glob.glob("*.xlsx")

dataframes = []

for file in files:
    print(f"Reading file: {file}")

    # Always read the "BD Exportaciones" worksheet
    df = pd.read_excel(file, sheet_name="BD Exportaciones")

    dataframes.append(df)

# Combine all dataframes into a single dataset
data = pd.concat(dataframes, ignore_index=True)

print("Files successfully combined.")
print(data.head())


# --------------------------------------------------
# 2. STANDARDIZE TEXT AND DATA TYPES
# --------------------------------------------------

# Ensure HS code is numeric
data["Codigo partida"] = pd.to_numeric(
    data["Codigo partida"],
    errors="coerce"
)

# Standardize destination country names
data["Pais destino"] = (
    data["Pais destino"]
    .astype(str)
    .str.strip()
    .str.title()
)


